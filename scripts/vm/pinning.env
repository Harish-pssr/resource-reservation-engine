# Core plan for the Linux benchmark machine (16 vCPUs = 8 cores x 2 threads). Edit it here and nowhere else:
# the same values are used to start everything and are recorded with every result.
#
# Contiguous ranges keep the two threads of a core together (check with `lscpu -e` on the machine), so
# no part shares a core with another part. CPU 15 is left free for the OS, the checker and SSH.
BENCH_MACHINE_TYPE=n2-standard-16
PG_CPUS=0-5
API_CPUS=6-9
BENCH_CPUS=10-13
REDIS_CPUS=14
SPARE_CPUS=15

# Core plan for the Linux benchmark machine (16 vCPUs = 8 physical cores x 2 threads). Edit it here and
# nowhere else: the same values start everything and are recorded with every result.
#
# The two threads of one physical core are NOT adjacent numbers on this kind of machine: here CPU n and
# CPU n+8 share a core (check with `lscpu -e=CPU,CORE`). So each part gets whole cores, thread pairs
# included, and no part shares a core with another part:
#   Postgres cores 0-2 (CPUs 0-2, 8-10), API cores 3-4 (CPUs 3-4, 11-12), bench cores 5-6 (CPUs 5-6, 13-14),
#   Redis core 7 (CPU 7), and CPU 15, the other thread of Redis's core, is left for the OS and SSH.
# scripts/vm/verify-pinning.sh also refuses a plan in which two parts share a core.
BENCH_MACHINE_TYPE=n2-standard-16
BENCH_BACKEND_PROFILE=full
BENCH_DB_POOL_SIZE=32
BENCH_MAX_INFLIGHT=20000
PG_CPUS=0-2,8-10
API_CPUS=3-4,11-12
BENCH_CPUS=5-6,13-14
REDIS_CPUS=7
SPARE_CPUS=15

# The constrained backend profile (BACKEND=small), used by the surge experiment (E3). A small database has a
# capacity (about 2,800 buyers/s for locking) that one load generator can offer a few multiples of; the full machine's
# capacity (about 5,500 buyers/s, bound by the API's pool of 32) leaves too little room above it. Everything else
# is as in pinning.env.
#   Postgres: ONE physical core (CPUs 0 and 8) and a pool of 8 connections in the API.
#   The load generator gets four cores (CPUs 1-2, 5-6, 9-10, 13-14): it has to offer several times the capacity.
#   BENCH_MAX_INFLIGHT: a surge with a waiting room keeps every waiting buyer in flight, so the generator's cap is raised.
# Whole cores again, no part sharing a core with another part (scripts/vm/verify-pinning.sh checks it).
BENCH_MACHINE_TYPE=n2-standard-16
BENCH_BACKEND_PROFILE=small
BENCH_DB_POOL_SIZE=8
BENCH_MAX_INFLIGHT=400000
PG_CPUS=0,8
API_CPUS=3-4,11-12
BENCH_CPUS=1-2,5-6,9-10,13-14
REDIS_CPUS=7
SPARE_CPUS=15

# The constrained backend profile (BACKEND=small): a deliberately small database so that its capacity is
# reachable and the surge experiment (E3) can offer 5x to 20x of it. Everything else is as in pinning.env.
#   Postgres: ONE physical core (CPUs 0 and 8) and a pool of 8 connections in the API.
#   The load generator gets four cores (CPUs 1-2, 5-6, 9-10, 13-14) because it has to send several times the capacity.
# Whole cores again, no part sharing a core with another part (scripts/vm/verify-pinning.sh checks it).
BENCH_MACHINE_TYPE=n2-standard-16
BENCH_BACKEND_PROFILE=small
BENCH_DB_POOL_SIZE=8
PG_CPUS=0,8
API_CPUS=3-4,11-12
BENCH_CPUS=1-2,5-6,9-10,13-14
REDIS_CPUS=7
SPARE_CPUS=15
